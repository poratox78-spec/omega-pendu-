# En-têtes Cloudflare Pages / Netlify (ignoré par GitHub Pages — sans effet là-bas).
/sw.js
  Cache-Control: no-cache
/manifest.json
  Content-Type: application/manifest+json
/app/omega-pendu.html
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(self), camera=(self)
  X-Frame-Options: SAMEORIGIN

# 22/10/2026 (ligne 136) — le COMPLÉMENT WORD : Word en ligne affiche le volet (word/taskpane) dans un CADRE de Microsoft Office.
# « X-Frame-Options: SAMEORIGIN » ci-dessus l'interdisait. On le retire pour /word/ seulement, et on n'autorise que les domaines
# d'Office à encadrer ces pages (frame-ancestors). Word sur le PC (bureau) n'en dépend pas.
/word/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://*.office.com https://*.officeapps.live.com https://*.office365.com https://*.microsoft.com https://*.sharepoint.com

# 10/10/2026 — le bot du Déformateur (dock d'OBS) et le plateau du pendu : seuls les fichiers du site s'exécutent, et la
# page ne parle qu'à Twitch et à l'outil sur le PC (127.0.0.1). Même chaîne que data_local/voix/bot/sondes/chrome_sonde.cjs.
/bot-moderation/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://id.twitch.tv https://api.twitch.tv wss://eventsub.wss.twitch.tv wss://irc-ws.chat.twitch.tv ws://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
